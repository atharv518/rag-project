# ── Database ──────────────────────────────────────────────────────────
# Supabase direct connection (dev / local): port 5432
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase transaction pooler (production / serverless): port 6543
# DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# ── Supabase API & Keys ───────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_BACKEND=supabase                        # "supabase" or "local" for offline dev
STORAGE_BUCKET_DOCUMENTS=ragproject-documents
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900           # 15 minutes

# ── Google Gemini LLM ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
GEMINI_LLM_MODEL=gemini-2.0-flash
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ── Google Gemini Embeddings ──────────────────────────────────────────
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=gemini
EMBEDDING_REQUEST_TIMEOUT_SECONDS=20

# ── Critical Privacy Gate: External AI Provider Data Handling ────────
# EXTERNAL_AI_DATA_TIER defines your provider tier:
# "free" = Unpaid tier (Google AI Studio free tier). Inputs/outputs eligible for Google training.
# "paid" = Commercial/enterprise paid tier with contractual non-training guarantee.
EXTERNAL_AI_DATA_TIER=free

# Mandatory Privacy Rule: Set to true ONLY if you have legal/organizational approval
# to run non-confidential test data on the free tier. Never enable for real confidential org data.
ALLOW_ORG_DATA_ON_FREE_TIER=false

# ── Auth & Security ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application Runtime ───────────────────────────────────────────────
APP_ENV=development                             # development | staging | production
APP_DEBUG=true
APP_CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=DEBUG

# ── Ingestion Limits ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
MAX_INGESTION_CONCURRENCY=3
INGESTION_TIMEOUT_SECONDS=300
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=100

# ── Public / Guest Quota ──────────────────────────────────────────────
GUEST_QUERY_QUOTA=10

